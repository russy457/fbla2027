rules_version = '2';

// firestore.rules
// Deny-all placeholder. The full rules matrix (public/private user split,
// signups, hours, letters, organizations, and every denied case) arrives in
// Tier 0 together with its emulator rules tests. Cloud Functions use the Admin
// SDK and are not bound by these rules, so they enforce their own checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
