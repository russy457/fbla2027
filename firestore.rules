rules_version = '2';

// firestore.rules
// Client access rules for the Tier 0 collections (docs/SPEC.md#rules-matrix).
// Cloud Functions use the Admin SDK and are NOT bound by these rules; every op
// authorizes itself (functions/src/lib/auth.ts). Clients therefore only READ,
// except the allowlisted display preferences on their own private profile.
// Anything not matched below is denied (default deny).
// Tests: tests/rules/firestore.rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // A real user session. Kiosk custom tokens carry kioskInstanceId and are
    // treated as a separate, much narrower role.
    function signedIn() {
      return request.auth != null && !('kioskInstanceId' in request.auth.token);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    // Owner or coordinator of the org (members doc exists with one of those roles).
    function isMember(orgId) {
      return signedIn()
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.role in ['owner', 'coordinator'];
    }

    // Minor coordinators never see contact snapshots (G14).
    function canViewContacts(orgId) {
      return isMember(orgId) && get(memberPath(orgId)).data.canViewContacts == true;
    }

    // A kiosk token scoped to this instance and not yet expired (kioskExp is epoch ms).
    function isKioskFor(instanceId) {
      return request.auth != null
        && request.auth.token.kioskInstanceId == instanceId
        && request.auth.token.kioskExp is number
        && request.auth.token.kioskExp > request.time.toMillis();
    }

    // ---------- public catalog ----------

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(orgId) || isSelf(uid);
        allow write: if false;
      }

      match /letterRefs/{letterId} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
    }

    // Collection-group access for the org switcher (SPEC Q27: collectionGroup
    // members where uid == me). Only the caller's own membership docs: the
    // check reads resource.data.uid (not the path id) so a `where uid == me`
    // query is provably safe and querying another uid is denied. Coordinator
    // reads of an org's roster still go through the nested rule above.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if true;
      allow write: if false;
    }

    match /instances/{instanceId} {
      allow read: if true;
      allow write: if false;
    }

    // Kiosk key material: never readable by any client.
    match /instanceSecrets/{instanceId} {
      allow read, write: if false;
    }

    // ---------- shifts ----------

    // The kiosk can read its own instance's roster (display names and status only).
    match /signups/{signupId} {
      allow read: if isSelf(resource.data.uid)
        || isMember(resource.data.orgId)
        || isKioskFor(resource.data.instanceId);
      allow write: if false;
    }

    // Contact data lives apart from signups so the kiosk never sees it.
    match /signupContacts/{signupId} {
      allow read: if canViewContacts(resource.data.orgId);
      allow write: if false;
    }

    // ---------- hours and letters ----------

    match /hoursLogs/{logId} {
      allow read: if isSelf(resource.data.uid) || isMember(resource.data.orgId);
      allow write: if false;
    }

    match /letters/{letterId} {
      allow read: if isSelf(resource.data.uid) || isAdmin();
      allow write: if false;
    }

    // Public by exact code only; listing would let anyone enumerate letters.
    match /letterVerifications/{verifyCode} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ---------- people ----------

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;

      match /private/profile {
        allow read: if isSelf(uid);
        allow create, delete: if false;
        // Only display preferences, each type-checked. birthDate, isMinor,
        // reliability, names, and every server field stay Function-only.
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['textSize', 'contrast', 'reducedMotion', 'notificationPrefs', 'milestonesSeen'])
          && validPreferences(request.resource.data);
      }
    }

    function validPreferences(data) {
      return (!('textSize' in data) || data.textSize in [100, 125, 150])
        && (!('contrast' in data) || data.contrast in ['normal', 'high'])
        && (!('reducedMotion' in data) || data.reducedMotion is bool)
        && (!('notificationPrefs' in data)
              || (data.notificationPrefs is map
                  && data.notificationPrefs.keys().hasOnly(['discoverable'])
                  && data.notificationPrefs.discoverable is bool))
        && (!('milestonesSeen' in data)
              || (data.milestonesSeen is list
                  && data.milestonesSeen.size() <= 3
                  && data.milestonesSeen.toSet().hasOnly([25, 50, 100])));
    }

    // ---------- system ----------

    match /jobRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Every signed-in client, including kiosks, applies the demo offset to countdowns.
    match /demoClock/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // rateLimits, jobLeases, turnstileTokens, aiUsage, meta: no client access
    // (covered by default deny; listed here so the matrix is explicit).
    match /rateLimits/{id} { allow read, write: if false; }
    match /jobLeases/{id} { allow read, write: if false; }
    match /turnstileTokens/{id} { allow read, write: if false; }
    // Tier 1 lane C: AI usage counters (askAssistant limits) are server-only.
    match /aiUsage/{id} { allow read, write: if false; }
    // Tier 1 review fix: pending T4 contact repairs (runDueJobs) are server-only.
    match /contactRefreshJobs/{orgId} { allow read, write: if false; }

    // Tier 1 lane B
    // Owner of the org (SPEC 4.3 isOwner).
    function isOrgOwner(orgId) {
      return signedIn()
        && exists(memberPath(orgId))
        && get(memberPath(orgId)).data.role == 'owner';
    }

    // Invite ids are code hashes; only the org owner may list them (SPEC 3.5).
    match /invites/{inviteId} {
      allow read: if isOrgOwner(resource.data.orgId);
      allow write: if false;
    }

    // Report metadata: the owner reads and deletes; Functions write (SPEC 3.21).
    match /reports/{reportId} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if false;
    }

    // Admin verification notes stay private (server-only).
    match /orgVerificationLog/{id} { allow read, write: if false; }
    // End Tier 1 lane B

    // Tier 1 lane A
    // In-app notifications (SPEC 3.15): the owner reads; only Functions write
    // (markNotificationsRead flips `read`).
    match /notifications/{uid}/items/{itemId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Saved items (SPEC 3.18): the owner reads, creates, and deletes. The id
    // must be {kind}_{refId}, the body exactly {kind, refId, savedAt}, and
    // savedAt the server time. No updates: save and unsave only.
    match /users/{uid}/saved/{itemId} {
      allow read, delete: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['kind', 'refId', 'savedAt'])
        && request.resource.data.keys().hasAll(['kind', 'refId', 'savedAt'])
        && request.resource.data.kind in ['org', 'opportunity']
        && request.resource.data.refId is string
        && request.resource.data.refId.size() > 0
        && request.resource.data.refId.size() <= 200
        && itemId == request.resource.data.kind + '_' + request.resource.data.refId
        && request.resource.data.savedAt == request.time;
      allow update: if false;
    }
    // End Tier 1 lane A

    // Tier 2 lane B
    // Curated collections (SPEC 3.19, 4.3; gate UC1: coordinator/admin-authored
    // only). Anyone reads a published collection; the org's coordinators and
    // admins also read drafts. Writes: org collections by the org's
    // coordinators, admin collections (orgId null) by admins. The author is
    // stamped on create and never changes; the org never changes either.
    // Rules cannot loop over a list, so each item's shape is checked by the
    // client schema on write and again when the app parses reads.
    function canCurate(orgId) {
      return orgId == null ? isAdmin() : (orgId is string && isMember(orgId));
    }

    function validCollection(data) {
      return data.keys().hasOnly(['title', 'description', 'items', 'orgId', 'authorUid', 'published', 'updatedAt'])
        && data.keys().hasAll(['title', 'description', 'items', 'orgId', 'authorUid', 'published', 'updatedAt'])
        && data.title is string && data.title.size() >= 4 && data.title.size() <= 80
        && data.description is string && data.description.size() <= 500
        && data.items is list && data.items.size() <= 30
        && data.published is bool
        && data.authorUid is string
        && data.updatedAt == request.time;
    }

    match /collections/{collectionId} {
      allow read: if resource.data.published == true
        || isAdmin()
        || (resource.data.orgId != null && isMember(resource.data.orgId));
      allow create: if signedIn()
        && validCollection(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && canCurate(request.resource.data.orgId);
      allow update: if signedIn()
        && validCollection(request.resource.data)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.orgId == resource.data.orgId
        && canCurate(resource.data.orgId);
      allow delete: if signedIn() && canCurate(resource.data.orgId);
    }

    // Org experience reviews (SPEC 3.20, 4.3). Public read. The id is the
    // signup id: the author must own that signup, it must be completed (they
    // attended), and it must belong to the reviewed org, so one review per
    // attended shift. The name is the author's public name (first name + last
    // initial, SPEC 4.2) or "A volunteer". Authors edit rating, tags, and text
    // at most once every 30 seconds (a simple write rate limit; an author's
    // delete waits too); org coordinators only set or clear the response;
    // authors and admins delete.
    function signupDoc(signupId) {
      return get(/databases/$(database)/documents/signups/$(signupId)).data;
    }

    function validReviewBody(data) {
      return data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.tags is list && data.tags.size() <= 5
        && data.tags.toSet().size() == data.tags.size()
        && data.tags.toSet().hasOnly(['well-organized', 'welcoming', 'meaningful-impact', 'good-communication', 'accessible'])
        && data.text is string && data.text.size() <= 1000;
    }

    function validReviewName(data) {
      return data.displayName == 'A volunteer'
        || data.displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
    }

    function validResponse(response) {
      return response == null
        || (response is map
            && response.keys().hasOnly(['text', 'by', 'at'])
            && response.keys().hasAll(['text', 'by', 'at'])
            && response.text is string && response.text.size() >= 1 && response.text.size() <= 1000
            && response.by == request.auth.uid
            && response.at == request.time);
    }

    match /reviews/{signupId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orgId', 'uid', 'displayName', 'rating', 'tags', 'text', 'response', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['orgId', 'uid', 'displayName', 'rating', 'tags', 'text', 'response', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && signupDoc(signupId).uid == request.auth.uid
        && signupDoc(signupId).status == 'completed'
        && signupDoc(signupId).orgId == request.resource.data.orgId
        && validReviewBody(request.resource.data)
        && validReviewName(request.resource.data)
        && request.resource.data.response == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isSelf(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'tags', 'text', 'updatedAt'])
          && validReviewBody(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.time > resource.data.updatedAt + duration.value(30, 's'))
        || (isMember(resource.data.orgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response'])
          && validResponse(request.resource.data.response));
      // The author's delete waits out the same cooldown, so delete + recreate cannot skip it.
      allow delete: if (isSelf(resource.data.uid) && request.time > resource.data.updatedAt + duration.value(30, 's'))
        || isAdmin();
    }
    // End Tier 2 lane B
  }
}
