# .env.example
# Copy to .env.local (PowerShell: copy .env.example .env.local, macOS/Linux: cp .env.example .env.local).
# Every value below is safe for local development with the Firebase Emulator Suite.
# None of these point at a real Firebase project. VITE_* values are bundled into
# the browser build, so never put a secret here.

# Firebase web config. "demo-" project ids make the emulators refuse real cloud access.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fbla2027.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-fbla2027
VITE_FIREBASE_STORAGE_BUCKET=demo-fbla2027.appspot.com
VITE_FIREBASE_APP_ID=demo-app

# true = connect Auth, Firestore, Functions, and Storage to the local emulators (npm run demo).
VITE_USE_EMULATORS=true

# Cloudflare Turnstile site key. This is Cloudflare's published always-pass TEST key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Set to false only when the deployed Functions server has TURNSTILE_ENABLED=false.
# Local emulators skip verification regardless of this flag.
VITE_TURNSTILE_ENABLED=true

# Optional Mapbox token for the Explore map view. Leave blank to show the list only (the
# List / Map switch is hidden). Only a PUBLIC token (starts with "pk.") with URL restrictions
# set to the deployed site may go here: it is bundled into the browser build. The app ignores
# anything that is not a pk. token. Never put a secret "sk." token in any file.
VITE_MAPBOX_TOKEN=

# Optional App Check (reCAPTCHA Enterprise) site key. Leave blank locally; App Check is skipped.
VITE_APPCHECK_SITE_KEY=

# Optional App Check debug token for development and Playwright (used only when the site key is set).
VITE_APPCHECK_DEBUG_TOKEN=

# ---- Cloud Functions settings (Tier 1 lane C; NOT read by the browser) ----
# Set these in functions/.env (or the deployed Functions environment), never as VITE_ variables.
# The help assistant (ai.askAssistant) is off by default, so the emulators and tests always use the
# deterministic fallback (top 3 matching help articles). To turn it on for a deploy:
#   AI_ENABLED=true
#   AI_PROVIDER=anthropic            (default; or openrouter)
#   AI_MODEL=claude-opus-5           (blank uses the provider default; required for openrouter)
#   AI_TIMEOUT_MS=10000
# and store the key as a Functions secret:
#   firebase functions:secrets:set ANTHROPIC_API_KEY   (or OPENROUTER_API_KEY)
# admin.resetDemoData on a deployed DEMO_MODE project reads the DEMO_ACCOUNT_PASSWORD secret.

# ---- Build-time site URL (Tier 2 lane C; read by Vite, not a secret) ----
# Public origin of the deployed site, used for canonical URLs, robots.txt, and sitemap.xml.
# Blank locally (the build falls back to http://localhost:5173 and warns). Set it before a
# deploy build, for example APP_BASE_URL=https://your-project.web.app
APP_BASE_URL=
