# .env.example
# Copy to .env.local (PowerShell: copy .env.example .env.local, macOS/Linux: cp .env.example .env.local).
# Every value below is safe for local development with the Firebase Emulator Suite.
# None of these point at a real Firebase project. VITE_* values are bundled into
# the browser build, so never put a secret here.

# Firebase web config. "demo-" project ids make the emulators refuse real cloud access.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fbla2027.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-fbla2027
VITE_FIREBASE_STORAGE_BUCKET=demo-fbla2027.appspot.com
VITE_FIREBASE_APP_ID=demo-app

# true = connect Auth, Firestore, Functions, and Storage to the local emulators (npm run demo).
VITE_USE_EMULATORS=true

# Cloudflare Turnstile site key. This is Cloudflare's published always-pass TEST key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional Mapbox public token (pk.*) for the map view. Leave blank to show the list only.
VITE_MAPBOX_TOKEN=

# Optional App Check (reCAPTCHA Enterprise) site key. Leave blank locally; App Check is skipped.
VITE_APPCHECK_SITE_KEY=

# Optional App Check debug token for development and Playwright (used only when the site key is set).
VITE_APPCHECK_DEBUG_TOKEN=
